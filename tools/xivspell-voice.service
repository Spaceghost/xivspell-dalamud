[Unit]
Description=Grimoire streaming-client microphone relay
After=xivspell-runtime.service xivspell-speech.service

[Service]
ExecStart=/usr/bin/python3 /var/home/jack/xivterm/xivspell/tools/voice_relay.py
EnvironmentFile=-%h/.config/xivspell/voice.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
